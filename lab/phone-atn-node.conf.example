# Example phone → single hub conf (DEC-0038)
# Copy to lab/phone-atn-node.conf (gitignored) and fill from:
#   - atnnode listen  (peer_port / peer_ek)
#   - edge panel      (hub_lan_ipv4 on Wi‑Fi, or public_ipv4 off-LAN)
# peer_ipv4 MUST NOT be 127.0.0.1 (phone is another host).

peer_ipv4=REPLACE_WITH_HUB_OR_PUBLIC_IPV4
peer_port=47000
peer_ek=REPLACE_WITH_HEX_FROM_LISTEN
diag=1
flush_mode=log_only
